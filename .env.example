# Copy to .env (git-ignored) and fill in.
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (named AGENT_EFFORT, not CLAUDE_EFFORT, which Claude Code sets)
AGENT_EFFORT=medium
# Server-side refusal fallback (fallbacks: "default", beta server-side-fallback-2026-07-01)
CLAUDE_FALLBACK=true
# The telemetry platform's warehouse and dbt docs (dbt docs generate). If these paths do
# not exist the agent falls back to the seed warehouse built by `make seed`.
WAREHOUSE_PATH=../telemetry-data-platform/data/warehouse.duckdb
DBT_TARGET_DIR=../telemetry-data-platform/dbt/target
# Expose staging models to the agent too (off: mart models only)
EXPOSE_STAGING=false
